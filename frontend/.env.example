# Скопируй этот файл в .env.local (он не коммитится) и правь под себя.
# После любой правки перезапусти npm run dev — на лету Vite это не подхватит.

# Куда dev-сервер проксирует /api. По умолчанию http://127.0.0.1:8000.
# Нужно, только если локальный FastAPI слушает другой порт.
# VITE_API_TARGET=http://127.0.0.1:8000

# Полностью перебить адрес API. Обычно НЕ нужен:
# в dev по умолчанию идёт /api (прокси, без CORS),
# в сборке — https://montiro.onrender.com
# Раскомментируй, если хочешь в dev ходить прямо на прод
# (тогда снова понадобится CORS на бэкенде).
# VITE_API_BASE=https://montiro.onrender.com
